# Rocket Launch EU API Environment Variables
#
# Copy this file to .env and fill in your values
# Example: cp .env.example .env

# Rocket Launch EU API Key - REQUIRED for authentication
# Clients must provide this key in the Authorization header to access the API
# Format: Authorization: Bearer <your-api-key>
# Generate a secure random key: uuidgen (on macOS/Linux)
RLEU_API_KEY=your-generated-api-key-here

# Debug mode - set to "true" to skip authentication and enable debug logging
# WARNING: Only use DEBUG mode for local development/testing
# When enabled:
# - Skips API key authentication
# - Shows API throttle status checks
# - Logs detailed request information
DEBUG=false

# Optional: ThespaceDevs API Key
# The RLEU API calls ThespaceDevs API (currently works without auth)
# Get your API key at: https://thespacedevs.com/ for higher rate limits
SPACEDEVS_API_KEY=
